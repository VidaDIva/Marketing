---
import ParticipationBars from '../../components/ParticipationBars.astro';
import RiskCard from '../../components/RiskCard.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { actividades } from '../../data/actividades';
import {
  daysBetween,
  formatDate,
  formatMoney,
  getActividad,
  getEntregablesPorObjetivo,
  getObjetivo,
  getRiesgosPorObjetivo,
} from '../../lib/helpers';
import { getAvanceCalculado, formatPorcentaje, getParticipantesActividad } from '../../lib/participacion';
import { FECHA_CORTE, getAvanceProgramado } from '../../lib/progreso';
import { getRegistroReal } from '../../lib/avance-real';
import { getDesviacion } from '../../lib/desviacion';
import DesviacionPill from '../../components/DesviacionPill.astro';

export function getStaticPaths() {
  return actividades.map((a) => ({ params: { id: String(a.id) } }));
}

const { id } = Astro.params as { id: string };
const actividad = getActividad(Number(id));

if (!actividad) {
  throw new Error(`Actividad ${id} no encontrada`);
}

const objetivo = getObjetivo(actividad.objetivoId);
const participantes = getParticipantesActividad(actividad.id);
const riesgos = objetivo ? getRiesgosPorObjetivo(objetivo.id) : [];
const entregables = objetivo ? getEntregablesPorObjetivo(objetivo.id) : [];
const avance = getAvanceCalculado([actividad]);
const avanceProg = getAvanceProgramado(actividad);
const registro = getRegistroReal(actividad.id);
---
<DashboardLayout
  title={actividad.nombre}
  subtitle={`Actividad A${String(actividad.id).padStart(2, '0')} del módulo de Marketing`}
>
  <section style="margin-bottom:16px">
    <a class="btn btn-ghost" href="/dashboard/actividades">← Volver a actividades</a>
  </section>

  <section>
    <div class="card">
      <div class="objetivo-hero">
        <div class="objetivo-hero-num" style="background:linear-gradient(135deg,#2563eb,#1d4ed8);box-shadow:0 8px 20px rgba(37,99,235,.3)">
          A{String(actividad.id).padStart(2, '0')}
        </div>
        <div style="flex:1;min-width:0">
          <h2 class="objetivo-hero-title" style="font-size:1.15rem">{actividad.nombre}</h2>
          <div class="objetivo-hero-badges">
            <StatusBadge status={actividad.estado ?? 'Sin estado registrado'} />
            <span class="objective-note">
              Avance real: {avance === null ? 'no calculado' : `${avance} %`} · Avance programado:{' '}
              {formatPorcentaje(avanceProg)}
            </span>
          </div>
          <p class="risk-detail" style="margin-top:10px">
            {participantes.length} {participantes.length === 1 ? 'participante' : 'participantes'} · la
            suma de la participación de esta actividad es 100 %.
          </p>
        </div>
      </div>

      <div class="meta-list" style="margin-top:6px">
        <div class="meta-row">
          <span class="meta-k">Objetivo relacionado</span>
          <span class="meta-v">{objetivo ? <a href={`/objetivos/${objetivo.id}`}>Objetivo {objetivo.numero}: {objetivo.nombre}</a> : 'General'}</span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Fecha de inicio</span>
          <span class="meta-v">{formatDate(actividad.fechaInicio)}</span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Fecha final</span>
          <span class="meta-v">{formatDate(actividad.fechaFinal)}</span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Duración</span>
          <span class="meta-v">{daysBetween(actividad.fechaInicio, actividad.fechaFinal)} días</span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Estado</span>
          <span class="meta-v"><StatusBadge status={actividad.estado ?? 'Sin estado registrado'} /></span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Avance real</span>
          <span class="meta-v">
            {avance === null
              ? 'No calculado · 0 de 1 actividad con dato reportado'
              : `${avance} % · 1 de 1 actividad con dato reportado`}
          </span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Avance programado (cronograma)</span>
          <span class="meta-v">
            {formatPorcentaje(avanceProg)} al {FECHA_CORTE} · {daysBetween(actividad.fechaInicio, actividad.fechaFinal)}{' '}
            días planificados
          </span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Desviación (real − programado)</span>
          <span class="meta-v"><DesviacionPill desviacion={getDesviacion(actividad.id)} /></span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Fecha de reporte</span>
          <span class="meta-v">
            {registro.fecha ? formatDate(registro.fecha) : 'Sin fecha (no hay avance reportado)'}
          </span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Nota de avance</span>
          <span class="meta-v">{registro.nota ?? 'Sin nota'}</span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Presupuesto de la actividad</span>
          <span class="meta-v">{formatMoney(actividad.presupuesto)}</span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Presupuesto del objetivo</span>
          <span class="meta-v">
            {objetivo ? formatMoney(actividades.filter((a) => a.objetivoId === objetivo.id).reduce((s, a) => s + a.presupuesto, 0)) : '-'}
          </span>
        </div>
        <div class="meta-row">
          <span class="meta-k">Entregables del objetivo</span>
          <span class="meta-v">
            {entregables.length > 0 ? entregables.map((e) => e.nombre).join(' · ') : 'Sin entregables asociados'}
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="grid grid-2">
      <div class="card">
        <h3>Participantes y participación</h3>
        <p class="card-sub">
          Porcentaje de participación de cada participante en esta actividad. La participación no
          modifica el presupuesto ni implica avance.
        </p>
        <ParticipationBars items={participantes} />
      </div>

      <div class="card">
        <h3>Riesgos del objetivo</h3>
        <p class="card-sub">Riesgos asociados al objetivo de esta actividad</p>
        {riesgos.length === 0 ? (
          <div class="empty-state">No hay riesgos registrados para este objetivo.</div>
        ) : (
          <div style="display:flex;flex-direction:column;gap:12px">
            {riesgos.map((r) => <RiskCard riesgo={r} showMitigacion={false} />)}
          </div>
        )}
        <div style="margin-top:14px"><a class="btn btn-ghost" href="/dashboard/riesgos">Ver riesgos →</a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="card">
      <h3>Siguientes pasos</h3>
      <p class="card-sub">Relaciones de navegación útiles</p>
      <div class="markers">
        {objetivo && (
          <a class="marker-item" href={`/objetivos/${objetivo.id}`}>
            <span class="marker-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" /></svg>
            </span>
            <span>Ver el objetivo {objetivo.numero} completo</span>
          </a>
        )}
        <a class="marker-item" href="/dashboard/equipo">
          <span class="marker-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 5 18.5V20M11 12a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5Z" /></svg>
          </span>
          <span>Ver la participación del equipo</span>
        </a>
        <a class="marker-item" href="/dashboard/actividades">
          <span class="marker-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.008v.008H3.75V6.75Zm0 5.25h.008v.008H3.75V12Zm0 5.25h.008v.008H3.75v-.008Z" /></svg>
          </span>
          <span>Todas las actividades del módulo</span>
        </a>
        <a class="marker-item" href="/dashboard/cronograma">
          <span class="marker-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75" /></svg>
          </span>
          <span>Ver el cronograma del módulo</span>
        </a>
      </div>
    </div>
  </section>
</DashboardLayout>
