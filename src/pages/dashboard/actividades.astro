---
import ActivityTable from '../../components/ActivityTable.astro';
import StatCard from '../../components/StatCard.astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { actividades } from '../../data/actividades';
import { getPresupuestoTotal } from '../../data/presupuesto';
import {
  formatPorcentaje,
  getAvanceCalculado,
  getContadorEstadosGlobal,
  getCoberturaAvanceReal,
} from '../../lib/participacion';
import { formatMoney } from '../../lib/helpers';
import { FECHA_CORTE, getAvanceProgramadoGlobal } from '../../lib/progreso';

const total = actividades.length;
const estados = getContadorEstadosGlobal();
const presupuesto = getPresupuestoTotal();
const avanceReal = getAvanceCalculado(actividades);
const cobertura = getCoberturaAvanceReal(actividades);
const avanceProgramado = getAvanceProgramadoGlobal();
---
<DashboardLayout
  title="Actividades del módulo"
  subtitle="Actividades con sus participantes, porcentaje de participación, presupuesto y estado."
>
  <section style="margin-bottom:20px">
    <div class="grid grid-4">
      <StatCard title="Total de actividades" value={total} icon="list" tone="neutral" caption="Planificadas para el módulo" />
      <StatCard
        title="En proceso"
        value={estados.enProceso}
        icon="list"
        tone="info"
        caption={estados.retrasadas ? `${estados.retrasadas} retrasadas` : 'Con estado "En proceso"'}
      />
      <StatCard
        title="No iniciadas"
        value={estados.pendientes}
        icon="list"
        tone="warning"
        caption="Con estado pendiente"
      />
      <StatCard
        title="Completadas"
        value={estados.completadas}
        icon="list"
        tone="success"
        caption={`Sin estado registrado: ${estados.sinEstado}`}
      />
    </div>
    <div class="grid grid-2" style="margin-top:16px">
      <StatCard
        title="Presupuesto total"
        value={formatMoney(presupuesto)}
        icon="coins"
        tone="primary"
        to="/dashboard/presupuesto"
        caption="Suma de los cinco objetivos"
      />
      <StatCard
        title="Avance real"
        value={avanceReal === null ? 'No calculado' : `${avanceReal} %`}
        icon="gauge"
        tone={avanceReal === null ? 'neutral' : 'success'}
        to="/dashboard/avance"
        caption={`Reportado en ${cobertura.reportadas} de ${total} actividades`}
      />
      <StatCard
        title="Avance programado"
        value={formatPorcentaje(avanceProgramado)}
        icon="calendar"
        tone="primary"
        caption={`Cronograma al ${FECHA_CORTE} (calendario, no ejecución)`}
      />
    </div>
  </section>

  <ActivityTable rows={actividades} />
</DashboardLayout>
