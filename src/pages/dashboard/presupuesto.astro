---
import BudgetChart from '../../components/BudgetChart.astro';
import DemoBadge from '../../components/DemoBadge.astro';
import DemoNote from '../../components/DemoNote.astro';
import DataTable from '../../components/DataTable.astro';
import StatCard from '../../components/StatCard.astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { objetivos } from '../../data/objetivos';
import { presupuestoGeneral, presupuestoPorObjetivo } from '../../data/presupuesto';
import { formatMoney } from '../../lib/helpers';

const budgetObj = objetivos.map((o) => {
  const p = presupuestoPorObjetivo.find((x) => x.objetivoId === o.id);
  return {
    label: `Objetivo ${o.numero}`,
    value: p?.total ?? 0,
  };
});

const tableRows = objetivos.map((o) => {
  const p = presupuestoPorObjetivo.find((x) => x.objetivoId === o.id);
  const distribucion = p ? Math.round((p.total / presupuestoGeneral.total) * 100) : 0;
  return {
    objetivo: `Objetivo ${o.numero}`,
    nombre: o.nombre,
    total: p ? formatMoney(p.total) : '-',
    distribucion: `${distribucion}%`,
    ejecutado: p ? formatMoney(p.ejecutado) : '-',
    pendiente: p ? formatMoney(p.pendiente) : '-',
    pct: p ? `${p.porcentajeEjecucion}%` : '-',
  };
});
---
<DashboardLayout
  title="Presupuesto del módulo"
  subtitle="Distribución del presupuesto por objetivo, con ejecución y saldos."
>
  <DemoNote text="El presupuesto total por objetivo es dato oficial del proyecto. Los montos ejecutados, pendientes y porcentajes de ejecución son valores DEMO para visualizar el comportamiento del presupuesto." />

  <section style="margin-bottom:20px">
    <div class="grid grid-4">
      <StatCard title="Presupuesto total" value={formatMoney(presupuestoGeneral.total)} icon="coins" tone="primary" caption="Los cinco objetivos" />
      <StatCard title="Ejecutado" value={formatMoney(presupuestoGeneral.ejecutado)} icon="coins" tone="success" demo caption="Monto DEMO según avance"
      />
      <StatCard title="Pendiente" value={formatMoney(presupuestoGeneral.pendiente)} icon="coins" tone="warning" demo caption="Total menos ejecutado (DEMO)" />
      <StatCard title="% de ejecución" value={`${presupuestoGeneral.porcentajeEjecucion}%`} icon="gauge" tone="info" demo caption="Proporción del total" />
    </div>
  </section>

  <section class="section">
    <div class="grid grid-2">
      <div class="card chart-card">
        <h3>Distribución del presupuesto</h3>
        <p class="chart-sub">Participación de cada objetivo en el total del módulo.</p>
        <BudgetChart data={budgetObj} variant="donut" totalLabel={formatMoney(presupuestoGeneral.total)} />
      </div>
      <div class="card chart-card">
        <h3>Distribución acumulada</h3>
        <p class="chart-sub">Barra apilada con la participación porcentual por objetivo.</p>
        <BudgetChart data={budgetObj} variant="stacked" />
        <p class="card-sub" style="margin-top:16px">
          <DemoBadge text="Ejecutado demo" tip="Los valores de ejecutado provienen de avances DEMO por objetivo." />
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>Detalle por objetivo</h2>
    </div>
    <DataTable
      columns={[
        { label: 'Objetivo', key: 'objetivo' },
        { label: 'Nombre', key: 'nombre' },
        { label: 'Presupuesto total', key: 'total' },
        { label: 'Distribución', key: 'distribucion' },
        { label: 'Ejecutado (demo)', key: 'ejecutado' },
        { label: 'Pendiente (demo)', key: 'pendiente' },
        { label: 'Ejecución', key: 'pct' },
      ]}
      rows={tableRows}
      searchable={true}
      empty="No hay información de presupuesto."
    />
  </section>
</DashboardLayout>