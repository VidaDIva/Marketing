---
import BudgetChart from '../../components/BudgetChart.astro';
import DataTable from '../../components/DataTable.astro';
import StatCard from '../../components/StatCard.astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { objetivos } from '../../data/objetivos';
import { actividades } from '../../data/actividades';
import {
  getPresupuestoPromedioObjetivo,
  getPresupuestoTotal,
  getPresupuestosPorObjetivo,
  getPorcentajeDelTotal,
} from '../../data/presupuesto';
import { formatMoney } from '../../lib/helpers';

const total = getPresupuestoTotal();
const presupuestos = getPresupuestosPorObjetivo();

const budgetObj = objetivos.map((o) => ({
  label: `Objetivo ${o.numero}`,
  value: presupuestos.find((p) => p.objetivoId === o.id)?.total ?? 0,
}));

const tableRows = objetivos.map((o) => {
  const p = presupuestos.find((x) => x.objetivoId === o.id);
  const totalObj = p?.total ?? 0;
  return {
    objetivo: `Objetivo ${o.numero}`,
    nombre: o.nombre,
    actividades: actividades.filter((a) => a.objetivoId === o.id).length,
    total: formatMoney(totalObj),
    porcentaje: `${getPorcentajeDelTotal(o.id)} %`,
    id: o.id,
  };
});

const totalRow = {
  objetivo: 'TOTAL',
  nombre: 'Módulo de Marketing',
  actividades: actividades.length,
  total: formatMoney(total),
  porcentaje: '100 %',
};
---
<DashboardLayout
  title="Presupuesto del módulo"
  subtitle="Presupuesto total, distribución por objetivo y detalle por actividad. Todos los totales se calculan desde las actividades."
>
  <section style="margin-bottom:20px">
    <div class="grid grid-4">
      <StatCard
        title="Presupuesto total"
        value={formatMoney(total)}
        icon="coins"
        tone="primary"
        caption={`${objetivos.length} objetivos · ${actividades.length} actividades`}
      />
      <StatCard
        title="Objetivos"
        value={objetivos.length}
        icon="target"
        tone="info"
        to="/dashboard/objetivos"
        caption="Objetivos del módulo"
      />
      <StatCard
        title="Actividades"
        value={actividades.length}
        icon="list"
        tone="neutral"
        to="/dashboard/actividades"
        caption="Con presupuesto asignado"
      />
      <StatCard
        title="Promedio por objetivo"
        value={formatMoney(getPresupuestoPromedioObjetivo())}
        icon="gauge"
        tone="success"
        caption="Total ÷ número de objetivos"
      />
    </div>
  </section>

  <section class="section">
    <div class="grid grid-2">
      <div class="card chart-card">
        <h3>Distribución del presupuesto</h3>
        <p class="chart-sub">Participación de cada objetivo en el total del módulo.</p>
        <BudgetChart data={budgetObj} variant="donut" totalLabel={formatMoney(total)} />
      </div>
      <div class="card chart-card">
        <h3>Distribución acumulada</h3>
        <p class="chart-sub">Barra apilada con la participación porcentual por objetivo.</p>
        <BudgetChart data={budgetObj} variant="stacked" />
        <p class="card-sub" style="margin-top:16px">
          El gráfico se actualiza automáticamente si cambia el presupuesto de una actividad.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>Distribución por objetivo</h2>
      <span class="table-muted">Porcentajes calculados sobre el total del módulo</span>
    </div>
    <DataTable
      columns={[
        { label: 'Objetivo', key: 'objetivo' },
        { label: 'Nombre', key: 'nombre' },
        { label: 'Actividades', key: 'actividades', align: 'right' },
        { label: 'Presupuesto', key: 'total', align: 'right' },
        { label: '% del total', key: 'porcentaje', align: 'right' },
      ]}
      rows={[...tableRows, totalRow]}
      link={(row) => (row.id ? `/objetivos/${row.id}` : undefined)}
      searchable={false}
      empty="No hay información de presupuesto."
    />
  </section>
</DashboardLayout>
