---
interface Props {
  text?: string;
}

const textoPorDefecto =
  'Los porcentajes de avance, montos ejecutados, indicadores de Marketing y demás cifras sin fuente oficial son DATOS DE DEMOSTRACIÓN utilizados solo para visualizar el dashboard. No representan información real del proyecto.';
const { text = textoPorDefecto } = Astro.props as Props;
---
<div class="demo-note" role="note">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
  </svg>
  <div>
    <strong>Datos de demostración</strong>
    <p>{text}</p>
  </div>
</div>