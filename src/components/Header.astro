---
import { proyecto } from '../data/proyecto';
import DemoBadge from './DemoBadge.astro';

interface Props {
  title: string;
}

const { title } = Astro.props as Props;
---
<header class="topbar">
  <div class="topbar-left">
    <button class="menu-toggle" data-menu-toggle type="button" aria-label="Abrir menú de navegación">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
    <div class="topbar-context">
      <span class="topbar-module">{proyecto.modulo} · {proyecto.cliente}</span>
      <span class="topbar-page">{title}</span>
    </div>
  </div>

  <div class="topbar-right">
    <div class="proyecto-chip" title="Estado del proyecto. Dato de demostración.">
      <span class="proyecto-chip-dot"></span>
      <span class="proyecto-chip-text">{proyecto.estado}</span>
      <DemoBadge />
    </div>
    <div class="user-chip" title={`${proyecto.usuario} · ${proyecto.cargo}`}>
      <span class="avatar">JD</span>
      <span class="user-meta">
        <strong>{proyecto.usuario}</strong>
        <small>{proyecto.cargo}</small>
      </span>
    </div>
  </div>
</header>